rules_version = '2';

// LightScore. Every device signs in anonymously; what it may read and change depends on the
// ensembles it has joined with their codes (src/ensembles.ts):
//
//   ensembleCodes/{codeId}              { ensemble }          codeId = salted SHA-256 of the code
//   leaderCodes/{codeId}                { ensemble }          the leaders' code (another salt)
//   members/{uid}/ensembles/{ensemble}  { code, joinedAt }    the ensembles a device has joined
//   leaders/{uid}/ensembles/{ensemble}  { code, joinedAt }    ... and those it leads
//   ensembles/{ensemble}                { name, codeId, leaderCodeId }
//   songs/{songId}                      { ensemble, ... }     each song belongs to one ensemble
//   sessions/live, sessions/live-<id>   rehearsing together: the first ensemble's, then the others'
//   sessions/clockPing_<uid>            each device's clock calibration
//
// Anything not matched below (config/access, the old PIN's hash, among it) is closed.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // The ensembles there are (src/ensembles.ts ENSEMBLES): nothing else can be set up or stored.
    function known(ensemble) {
      return ensemble in ['nnb', 'rm', 'frederick'];
    }

    // A code document that opens the ensemble.
    function opens(codeId, ensemble) {
      return codeId is string && exists(/databases/$(database)/documents/ensembleCodes/$(codeId))
        && get(/databases/$(database)/documents/ensembleCodes/$(codeId)).data.ensemble == ensemble;
    }

    // A leaders' code document that opens the ensemble.
    function leaderOpens(codeId, ensemble) {
      return codeId is string && exists(/databases/$(database)/documents/leaderCodes/$(codeId))
        && get(/databases/$(database)/documents/leaderCodes/$(codeId)).data.ensemble == ensemble;
    }

    // The ensemble's leaders change its code and name and keep the leaders' code; a device becomes
    // one with that code.
    function leaderOf(ensemble) {
      return signedIn() && ensemble is string
        && exists(/databases/$(database)/documents/leaders/$(request.auth.uid)/ensembles/$(ensemble));
    }

    // No leaders' code yet: a member may set the first one (and with it become a leader).
    function leaderless(ensemble) {
      return !('leaderCodeId' in get(/databases/$(database)/documents/ensembles/$(ensemble)).data);
    }

    function memberOf(ensemble) {
      return signedIn() && ensemble is string
        && exists(/databases/$(database)/documents/members/$(request.auth.uid)/ensembles/$(ensemble));
    }

    // An ensemble nobody guards yet (no code set): whoever sets it up gives it its first code.
    function unclaimed(ensemble) {
      return !exists(/databases/$(database)/documents/ensembles/$(ensemble))
        || !('codeId' in get(/databases/$(database)/documents/ensembles/$(ensemble)).data);
    }

    // A code's document. Fetching it needs the code in hand (its id is derived from it -- a
    // SHA-256, nothing shorter); listing them never works, and an existing one can't be pointed at
    // another ensemble.
    match /ensembleCodes/{codeId} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && codeId.matches('[0-9a-f]{64}')
        && request.resource.data.keys().hasOnly(['ensemble'])
        && known(request.resource.data.ensemble)
        && (leaderOf(request.resource.data.ensemble) || unclaimed(request.resource.data.ensemble));
      allow update: if false;
      allow delete: if leaderOf(resource.data.ensemble);
    }

    // The leaders' codes: the same, set and retired by leaders -- the first one by any member.
    match /leaderCodes/{codeId} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && codeId.matches('[0-9a-f]{64}')
        && request.resource.data.keys().hasOnly(['ensemble'])
        && known(request.resource.data.ensemble)
        && (leaderOf(request.resource.data.ensemble)
          || (memberOf(request.resource.data.ensemble) && leaderless(request.resource.data.ensemble)));
      allow update: if false;
      allow delete: if leaderOf(resource.data.ensemble);
    }

    // Joining: a device adds an ensemble to its own list by naming a code document that opens it
    // (the leaders' code opens it too).
    match /members/{uid}/ensembles/{ensemble} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid && known(ensemble)
        && (opens(request.resource.data.code, ensemble) || leaderOpens(request.resource.data.code, ensemble));
    }

    // Leading: likewise, naming a leaders' code document.
    match /leaders/{uid}/ensembles/{ensemble} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid && known(ensemble)
        && leaderOpens(request.resource.data.code, ensemble);
    }

    // An ensemble's name and current codes: for its members (and readable while it's unguarded,
    // so the app can offer to set it up). Its leaders change them; a member may only guard an
    // unguarded ensemble (its first code) or give it its first leaders' code. It always keeps a code
    // that opens it, and once it has a leaders' code, a valid one -- nobody can delete it or drop
    // its codes, which would leave it open to be claimed again.
    match /ensembles/{ensemble} {
      allow read: if memberOf(ensemble) || (signedIn() && known(ensemble) && (resource == null || !('codeId' in resource.data)));
      allow create: if memberOf(ensemble) && opens(request.resource.data.codeId, ensemble)
        && request.resource.data.keys().hasOnly(['codeId', 'name']);
      allow update: if memberOf(ensemble) && opens(request.resource.data.codeId, ensemble)
        && (('leaderCodeId' in request.resource.data && leaderOpens(request.resource.data.leaderCodeId, ensemble))
          || (!('leaderCodeId' in request.resource.data) && !('leaderCodeId' in resource.data)))
        && (leaderOf(ensemble)
          || (!('codeId' in resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['codeId']))
          || (!('leaderCodeId' in resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leaderCodeId'])));
      allow delete: if false;
    }

    // The repertoire: only an ensemble's members see, add, change or delete its songs; moving a
    // song needs membership of both ensembles.
    match /songs/{songId} {
      allow read: if memberOf(resource.data.ensemble);
      allow create: if memberOf(request.resource.data.ensemble);
      allow update: if memberOf(resource.data.ensemble) && memberOf(request.resource.data.ensemble);
      allow delete: if memberOf(resource.data.ensemble);
    }

    match /sessions/{sessionId} {
      allow read, write: if (sessionId == 'live' && memberOf('nnb'))
        || (sessionId.matches('live-[a-z0-9]+') && known(sessionId.split('-')[1]) && memberOf(sessionId.split('-')[1]));
      // A device's clock calibration: its own document only, holding only the server's time.
      allow read, delete: if signedIn() && sessionId == 'clockPing_' + request.auth.uid;
      allow create, update: if signedIn() && sessionId == 'clockPing_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['ts']);
    }
  }
}
