# Copy to .env and fill in (never commit .env).

# The (sub)domain pointing at this server, e.g. scan.mein-chor.de -- Caddy gets its certificate.
OMR_DOMAIN=scan.example.org

# OpenAI key for the GPT check (platform.openai.com -> API keys) and the model to use.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
# OPENAI_REASONING_EFFORT=medium

# Where the app runs -- only these pages may use the service.
ALLOWED_ORIGINS=https://emanorick.github.io

# The Firebase project whose sign-ins are accepted.
FIREBASE_PROJECT_ID=ai-capella
