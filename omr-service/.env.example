# Copy to .env and fill in (never commit .env).

# The (sub)domain pointing at this server, e.g. scan.mein-chor.de -- Caddy gets its certificate.
OMR_DOMAIN=scan.example.org

# OpenAI key (platform.openai.com -> API keys) and the model that reads and checks the pages.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
# OPENAI_REASONING_EFFORT=high
# How closely the model looks at a page image ("high"; "original" where the model offers it).
# OPENAI_IMAGE_DETAIL=high
# Pages read and checked at the same time.
# REVIEW_CONCURRENCY=4

# Where the app runs -- only these pages may use the service.
ALLOWED_ORIGINS=https://emanorick.github.io

# The Firebase project whose sign-ins are accepted.
FIREBASE_PROJECT_ID=ai-capella
